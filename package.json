{
  "name": "folio-project-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"npm:dev --prefix backend\" \"npm:dev --prefix frontend\"",
    "dev:web": "npm run dev --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
